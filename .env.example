# nbPlatform. Ports 8090/8001 in both dev and production, so the v2 stack can
# sit next to v1 on the same server. The compose project is named "nbplatform".
POSTGRES_DB=nbplatform
POSTGRES_USER=nbplatform
POSTGRES_PASSWORD=change-this-password
API_PORT=8001
WEB_PORT=8090
FRONTEND_ORIGIN=http://localhost:8090

# The hostname(s) that serve the admin, comma-separated. Every other hostname
# is looked up in store_domains. Runtime var.
ADMIN_HOST=admin.naturebazar.bd

# --- Development only: leave BOTH empty in production ------------------------
# Lets ?__store=<slug> pick a store on plain localhost (see DEV.md).
DEV_STORE_FALLBACK=
# POST /api/auth/dev-login signs this account in as super admin without Google.
DEV_LOGIN_EMAIL=
# Google sign-in for staff (admin domain). Runtime var served to the login
# page by /api/auth/providers: no rebuild after changing it. Only the client
# id is used (ID tokens are verified server-side); the secret is not read.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPER_ADMIN_EMAILS=you@example.com
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Encrypts per-store secrets in store_settings. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated for rotation: the first key encrypts, all of them decrypt.
# Back it up: without it every stored secret is unreadable.
APP_ENCRYPTION_KEY=

# Header the proxy in front of the app puts the real client IP in, used for
# per-IP rate limiting: cf-connecting-ip behind Cloudflare, x-forwarded-for
# behind nginx/LiteSpeed. Runtime var: `docker compose up -d --force-recreate api`.
CLIENT_IP_HEADER=x-forwarded-for

# Meta Pixel / Conversions API are per store: Admin → Settings. Only the
# optional platform-wide GTM container lives here (runtime var).
GTM_ID=
# POST /api/track (server copies of browser Pixel events), per IP per minute.
RATE_LIMIT_TRACK=60

# Pathao credentials are per store (Admin → Settings). The environment is
# deployment-wide: sandbox for testing, https://api-hermes.pathao.com live.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
# FraudBD (customer courier history by phone; key per store in Settings).
# 1 = use fraudbd.com's sandbox endpoints (dev). MUST be empty in production.
FRAUDBD_SANDBOX=

# --- Products ---------------------------------------------------------------
# The catalogue lives only in the database and is edited at /admin/products.
# There is no fallback product: with nothing live the shop says it is closed.
# Where uploaded product images are written inside the api container. compose
# mounts the `media` named volume here — never point this at a path inside the
# image, or every upload is lost on the next rebuild.
MEDIA_ROOT=/app/media
# Largest accepted product image, in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# --- Landing page -----------------------------------------------------------
# The previous landing page is preserved at /legacy, which 404s for everyone
# unless this is set to 1. Keep it empty in production: it is a working copy of
# the old shop, order form included, not a static snapshot.
SHOW_LEGACY_LANDING=
